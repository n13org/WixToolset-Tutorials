                Description="Microsoft .NET 9.0 (9.0.14) ASP.NET Core for windows x86"
                PerMachine="yes" Permanent="yes" Vital="yes" InstallArguments="/norestart /quiet"
                DetectCondition="DOT_NET_VER &gt;= v9.0.14"
                bal:PrereqPackage="yes">
