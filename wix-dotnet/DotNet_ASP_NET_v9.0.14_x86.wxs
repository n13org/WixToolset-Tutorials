            Name="runtime-aspnetcore-9.0.14-windows-x86.exe"
            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/9.0.14/aspnetcore-runtime-9.0.14-win-x86.exe"
            Hash="35c2a38113638c5eb0b3f69953811ef4a2c1f248f6c54f49e500ef8b1c3d21c01a38f4eb108b292d8f1647a07799a27ccda2ea86f9b9fe226edfe05fa377a627"
            Size="9904984" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
