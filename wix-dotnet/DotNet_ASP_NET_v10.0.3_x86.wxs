            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.3/aspnetcore-runtime-10.0.3-win-x86.exe"
            Hash="e359395eb1b99931493203c3d2864cae8be905eb16afc39e7142bb36f95a3c9b318efcb5235d10c55263cfe7b8c40acec46805bfbe9163711fa740484480482d"
            Size="10844440" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
