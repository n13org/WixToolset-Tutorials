            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/9.0.6/aspnetcore-runtime-9.0.6-win-x86.exe"
            Hash="1fc880f391d1620374a0d4055bb369966bf7791d74e09fbafc3791eb40380d6267511a11da91941f695885d5540639cd42f37e80575ecec941eee90885f05f5e"
            Size="9869424" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
