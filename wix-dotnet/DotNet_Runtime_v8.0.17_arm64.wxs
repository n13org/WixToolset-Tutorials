            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.17/dotnet-runtime-8.0.17-win-arm64.exe"
            Hash="58ef6b454e8513f3d062dfe195b713442ae7344e46b78dcb3488138232b4b087858065887013585b18139f0e87b885c855bcd5ad198081346501e8ef52ff9aca"
            Size="27576952" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
