                Description="Microsoft .NET 8.0 (8.0.17) Runtime for windows arm64"
                PerMachine="yes" Permanent="yes" Vital="yes" InstallArguments="/norestart /quiet"
                DetectCondition="DOT_NET_VER &gt;= v8.0.17"
                bal:PrereqPackage="yes">
        <ExePackagePayload
