        RuntimeType="aspnet"
        Platform="arm64"
        MajorVersion="8"
        Variable="DOT_NET_VER" />

    <PackageGroup Id="DotNet_ASP_NET_v8_0_20_arm64">
    <ExePackage Id="Netfx80"
