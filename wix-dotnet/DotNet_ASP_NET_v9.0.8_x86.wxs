            Name="runtime-aspnetcore-9.0.8-windows-x86.exe"
            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/9.0.8/aspnetcore-runtime-9.0.8-win-x86.exe"
            Hash="e26fe236ad8c3cb54fab4ad2362a644ec931ade7c473de9e3ccd0b9203b66236453dee3953f958bb0237260f0a2920395cba1967e979a2856f0184e92ef2468b"
            Size="9898520" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
