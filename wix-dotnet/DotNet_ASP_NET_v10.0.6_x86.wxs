            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.6/aspnetcore-runtime-10.0.6-win-x86.exe"
            Hash="e299d6b3beff831491e8f2669944dbf18c44eb8062fa7bab396be7866ccf4968d1b2d79b0c605d577a0cb175a6f09f7e0fd6fcbca9facae4fca538a1609bd168"
            Size="10798712" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
