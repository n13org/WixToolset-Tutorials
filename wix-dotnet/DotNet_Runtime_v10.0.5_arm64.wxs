            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/Runtime/10.0.5/dotnet-runtime-10.0.5-win-arm64.exe"
            Hash="f2fbf6e30010639ad63933bf7b93cace6ff062f24520628fe3180660d662bfd676c7ac3fe019a0033e9b48b785a9db5f8904a3c19f1ec8607a6e5c6ff1c98418"
            Size="28380152" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
