            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/9.0.8/windowsdesktop-runtime-9.0.8-win-x64.exe"
            Hash="14eeae9e47137f0d550e4ab73ada9c8e253f9c989ea975789d70d9f605bf946f4e9cddf0d2bc8028ca3ad10d9277f51181db94cb3623798fb876e637d283f93e"
            Size="60821200" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="scheduleReboot" />
    </ExePackage>
    </PackageGroup>
    </Fragment>
</Wix>
